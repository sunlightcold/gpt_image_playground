#!/bin/sh

# 兼容旧版本 Docker 环境变量：API_URL 同时作为两个新变量的兜底值。
DOCKER_LEGACY_API_URL_USED=false
if [ -n "$API_URL" ]; then
    DOCKER_LEGACY_API_URL_USED=true
fi

if [ "${DEFAULT_API_URL+x}" != "x" ]; then
    DEFAULT_API_URL=${API_URL:-https://api.proxy2it.com/v1}
fi
API_PROXY_URL=${API_PROXY_URL:-${API_URL:-https://api.proxy2it.com/v1}}
API_PROXY_SERVER_HOST=${API_PROXY_SERVER_HOST:-127.0.0.1}
API_PROXY_SERVER_PORT=${API_PROXY_SERVER_PORT:-8787}
API_PROXY_HEARTBEAT_MS=${API_PROXY_HEARTBEAT_MS:-15000}
API_PROXY_READ_TIMEOUT=${API_PROXY_READ_TIMEOUT:-600s}
API_PROXY_SEND_TIMEOUT=${API_PROXY_SEND_TIMEOUT:-600s}

export DEFAULT_API_URL
export API_PROXY_URL
export API_PROXY_SERVER_HOST
export API_PROXY_SERVER_PORT
export API_PROXY_HEARTBEAT_MS
export API_PROXY_READ_TIMEOUT
export API_PROXY_SEND_TIMEOUT
export DOCKER_LEGACY_API_URL_USED
