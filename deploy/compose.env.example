IMAGE=ghcr.io/your-github-user/gpt_image_playground:latest
APP_HOST=127.0.0.1
APP_PORT=8080

# Leave empty when LOCK_API_PROXY=true to avoid exposing the real upstream in the UI.
DEFAULT_API_URL=
API_PROXY_URL=https://cn.proxy2it.com/v1
API_PROXY_HEARTBEAT_MS=15000
API_PROXY_READ_TIMEOUT=600s
API_PROXY_SEND_TIMEOUT=600s
ENABLE_API_PROXY=true
LOCK_API_PROXY=true
