IMAGE=ghcr.io/your-github-user/gpt_image_playground:latest
APP_HOST=127.0.0.1
APP_PORT=8080

# Leave empty when LOCK_API_PROXY=true to avoid exposing the real upstream in the UI.
DEFAULT_API_URL=
API_PROXY_URL=https://api.proxy2it.com/v1
API_PROXY_RESOLVER=1.1.1.1 8.8.8.8
ENABLE_API_PROXY=true
LOCK_API_PROXY=true
