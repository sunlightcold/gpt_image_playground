IMAGE=ghcr.io/your-github-user/gpt_image_playground:latest
APP_HOST=127.0.0.1
APP_PORT=8080

# Leave empty when LOCK_API_PROXY=true to avoid exposing the real upstream in the UI.
DEFAULT_API_URL=
API_PROXY_URL=https://img.proxy2it.com/v1
API_PROXY_HEARTBEAT_MS=15000
API_PROXY_READ_TIMEOUT=600s
API_PROXY_SEND_TIMEOUT=600s
ENABLE_API_PROXY=true
LOCK_API_PROXY=true

# Runtime prompt case dataset. The server reads this JSON at request time; no
# container restart is needed after the GitHub Actions sync updates the file.
PROMPT_CASE_DATASET_URL=https://raw.githubusercontent.com/sunlightcold/gpt_image_playground/main/public/data/gpt-image-2/cases.json
PROMPT_CASE_DATASET_CACHE_SECONDS=600
