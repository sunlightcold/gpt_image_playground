{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-image-playground",
  "compatibility_date": "2026-05-07",
  "main": "src/worker.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "image.proxy2it.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api-proxy/*"]
  }
}
